[Unit]
Description=Template independent read-only update progress
Requires=myscoutee-template-update-status.socket
After=myscoutee-template-update-status.socket

[Service]
User=myscoutee-template-runtime
Group=myscoutee-template-runtime
ExecStart=/usr/bin/python3 -B /opt/myscoutee-template/packaging/scripts/update-status-server.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
BindReadOnlyPaths=/var/lib/myscoutee-template/update/inbox/staging:/run/myscoutee-update-reader/inbox/staging
BindReadOnlyPaths=/var/lib/myscoutee-template/update/runtime/jobs:/run/myscoutee-update-reader/runtime/jobs
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M
TasksMax=8
UMask=0077
