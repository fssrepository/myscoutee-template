[Unit]
Description=Template production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Wants=myscoutee-template-update-status.socket
After=myscoutee-template-update-status.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/myscoutee-template/server
EnvironmentFile=-/etc/myscoutee-template/myscoutee-template.env
ExecStartPre=/opt/myscoutee-template/packaging/scripts/reset-demo-state.sh
ExecStartPre=/opt/myscoutee-template/packaging/scripts/sync-i18n-seeds.sh --prepare-only
ExecStartPre=/opt/myscoutee-template/packaging/scripts/migrate-production-data.sh
ExecStart=/opt/myscoutee-template/packaging/scripts/myscoutee-compose.sh up -d
ExecStop=/opt/myscoutee-template/packaging/scripts/myscoutee-compose.sh down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
