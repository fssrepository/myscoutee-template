[Unit]
Description=Renew operator-managed Template certificates when enabled
After=network-online.target docker.service myscoutee-template.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/myscoutee-template/myscoutee-template.env
Environment=MYSCOUTEE_TLS_STATE_DIR=/var/lib/myscoutee-template/tls
ExecStart=/usr/bin/flock /run/myscoutee-template-tls-worker.lock /opt/myscoutee-template/packaging/scripts/myscoutee-tls-worker.sh --renew
UMask=0077
TimeoutStartSec=20min
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
