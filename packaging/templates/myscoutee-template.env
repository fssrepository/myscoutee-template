# Template production environment. Installed under /etc/myscoutee-template.
MYSCOUTEE_VERSION=1.4.0
NGINX_BASE_IMAGE=myscoutee-template-nginx:1.4.0-base
NGINX_PRODUCTION_IMAGE=myscoutee-template-nginx:1.4.0-prod
MYSCOUTEE_PRODUCTION_IMAGE=myscoutee-template-api:1.4.0-prod
MINIO_PRODUCTION_IMAGE=myscoutee-template-minio:1.4.0-prod
MCP_IMAGE=myscoutee-template-mcp:1.4.0-prod
MONGO_IMAGE=mongo:8.0.4
REDIS_IMAGE=redis:8.6.1-alpine
MINIO_BASE_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
CERT_BOT=certbot/certbot:v5.4.0
MONGO_DEMO_DATABASE=demo_db
MONGO_REAL_DATABASE=production_db
MONGO_INITDB_DATABASE=production_db
MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB=demo_db:*;production_db:accessPolicyDefinitions,appSettings,countryPartitions,deploymentConfigurations,helpCenterGuideFields,helpCenterRevisions,i18n_bundles,i18n_messages,notificationRuleConfigs
CONTAINER_TIMEZONE=Europe/Brussels
MEDIA_BUCKET=myscoutee-media
MONGO_REPLICA_SET_ENABLED=true
MONGO_REPLICA_SET_NAME=rs0
MONGO_REPLICA_SET_HOST=mongodb:27017
MONGO_REPLICA_SET_INIT_RETRIES=60
MONGO_REPLICA_SET_INIT_DELAY_SECONDS=2
OPERATOR_CONFIGURATION_MASTER_KEY_PATH=/etc/myscoutee/configuration/deployment-master-key
OPERATOR_CONFIGURATION_KEY_DIR_HOST=/etc/myscoutee-template/configuration
MYSCOUTEE_UPDATE_TLS_CA_CERTIFICATE=
MYSCOUTEE_UPDATE_RELEASE_API_ORIGIN=https://api.github.com
MYSCOUTEE_UPDATE_RELEASE_DOWNLOAD_ORIGIN=https://github.com
MYSCOUTEE_UPDATE_GITHUB_REPOSITORY=fssrepository/myscoutee-template
MYSCOUTEE_UPDATE_INCLUDE_PRERELEASES=false
MYSCOUTEE_UPDATE_ENABLED=false
MYSCOUTEE_UPDATE_CACHE_DIR=/var/cache/myscoutee-template-update
MYSCOUTEE_UPDATE_AUDIT_DIR=/var/log/myscoutee-template/update
MYSCOUTEE_UPDATE_RELEASE_PUBLIC_KEY=/etc/myscoutee-template/update/release-public-key.pem
MYSCOUTEE_UPDATE_MAX_ARTIFACT_BYTES=4294967296
MYSCOUTEE_UPDATE_STAGING_SAFETY_RESERVE_BYTES=536870912
MYSCOUTEE_UPDATE_MIN_FREE_BYTES=536870912
MYSCOUTEE_UPDATE_HEALTH_TIMEOUT_SECONDS=300
MYSCOUTEE_UPDATE_CACHE_RETENTION_JOBS=2
FIREBASE_ENABLED=false
AUTH_MAX_ACTIVE_SESSIONS=-1
OPERATOR_USER=
LETSENCRYPT_ENABLED=false
DOMAIN=localhost
NGINX_TLS_CERTIFICATE_PATH=/etc/nginx/keys/nginx.crt
NGINX_TLS_CERTIFICATE_KEY_PATH=/etc/nginx/keys/nginx-nopass.key
OPERATOR_TLS_ENABLED=true
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://localhost,https://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080
EMAIL_BASE_URL=https://localhost
CHAT_CALL_STUN_URLS=
CHAT_CALL_STUN_PORT=3478
