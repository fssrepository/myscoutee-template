MYSCOUTEE_VERSION=1.4.0
MONGO_IMAGE=mongo:8.0.4
REDIS_IMAGE=redis:8.6.1-alpine
MONGO_DEMO_DATABASE=demo_db
MONGO_REAL_DATABASE=production_db
MONGO_E2E_DATABASE=e2e_db
MEDIA_BUCKET=myscoutee-media
CONTAINER_TIMEZONE=Europe/Brussels
# Public application origin used for email logos and unsubscribe links.
# Configure/enable the provider and its encrypted credential in Operator settings.
EMAIL_BASE_URL=http://localhost
EMAIL_SENDGRID_ENDPOINT=https://api.sendgrid.com/v3/mail/send

MONGO_IMPORT_ALLOWED_COLLECTIONS_BY_DB=demo_db:*;e2e_db:*;myscoutee_db:countryPartitions,i18n_bundles,i18n_messages,helpCenterRevisions,helpCenterGuideFields,appSettings,notificationRuleConfigs,accessPolicyDefinitions,deploymentConfigurations;production_db:countryPartitions,i18n_bundles,i18n_messages,helpCenterRevisions,helpCenterGuideFields,appSettings,notificationRuleConfigs,accessPolicyDefinitions,deploymentConfigurations
