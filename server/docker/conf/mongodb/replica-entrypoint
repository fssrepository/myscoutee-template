#!/usr/bin/env bash
# The official entrypoint still owns users, seed hooks, privileges and mongod.
# Its temporary init daemon has no replica set, so initialize after final startup.
set -euo pipefail
key=/data/db/.myscoutee-replica-key
if [[ ! -e "$key" ]]; then
  umask 077
  temporary="$(mktemp /data/db/.myscoutee-replica-key.XXXXXX)"
  openssl rand -base64 756 > "$temporary"
  chown mongodb:mongodb "$temporary"
  chmod 0400 "$temporary"
  mv -n "$temporary" "$key"
  rm -f "$temporary"
fi
[[ -f "$key" && ! -L "$key" && -s "$key" ]] || { echo 'Invalid Mongo replica key file' >&2; exit 1; }
chown mongodb:mongodb "$key"
chmod 0400 "$key"
(
  export MONGO_REPLICA_SET_ENSURE_READY=true
  error_file="$(mktemp)"
  trap 'rm -f "$error_file"' EXIT
  for ((attempt=1; attempt<=${MONGO_REPLICA_SET_INIT_RETRIES:-90}; attempt++)); do
    if mongosh 'mongodb://127.0.0.1:27017/?directConnection=true' --quiet \
        --file /docker-entrypoint-initdb.d/00_replica_set.js > "$error_file" 2>&1; then
      cat "$error_file"
      exit 0
    fi
    sleep "${MONGO_REPLICA_SET_INIT_DELAY_SECONDS:-2}"
  done
  echo 'Mongo replica initialization failed; refusing to leave an uninitialized server running.' >&2
  cat "$error_file" >&2
  kill -TERM 1
) &
exec /usr/local/bin/docker-entrypoint.sh "$@" --keyFile "$key"
