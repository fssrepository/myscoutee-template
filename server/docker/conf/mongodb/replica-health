#!/usr/bin/env bash
set -euo pipefail
exec mongosh 'mongodb://127.0.0.1:27017/?directConnection=true' --quiet --eval '
const admin=db.getSiblingDB("admin");
if(!admin.auth(process.env.MONGO_INITDB_ROOT_USERNAME,process.env.MONGO_INITDB_ROOT_PASSWORD).ok)quit(1);
const hello=admin.runCommand({hello:1});
quit(hello.isWritablePrimary && hello.setName===process.env.MONGO_REPLICA_SET_NAME ? 0 : 1);'
