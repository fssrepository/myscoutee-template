    "updatedUser": "system",
    "sections": [
      {
        "id": "guide-help",
        "guideStepId": "help",
        "icon": "help_outline",
        "title": "Device-specific instructions",
        "blurb": "",
        "contentHtml": "<p>The question mark explains browser and phone differences, including blocked permissions. Open it if your device does not offer the expected permission or install prompt.</p>"
      },
      {
        "id": "guide-location",
        "guideStepId": "location",
        "icon": "help_outline",
        "title": "Location",
        "blurb": "",
        "contentHtml": "<p>Save your current location or turn off automatic updates. The browser requests permission only when you apply the selected setting.</p>"
      },
      {
        "id": "guide-notifications",
        "guideStepId": "notifications",
        "icon": "help_outline",
        "title": "Notifications on this device",
        "blurb": "",
        "contentHtml": "<p>Enable notifications to receive updates outside the open app. Availability depends on this device, browser and deployment; a disabled control cannot request permission.</p>"
      },
      {
        "id": "guide-permissions-save",
        "guideStepId": "permissions-save",
        "icon": "help_outline",
        "title": "Apply the selected permissions",
        "blurb": "",
        "contentHtml": "<p>Apply sends the selected permission requests to the browser. A blocked permission must be changed in site settings; pressing again cannot override a browser denial.</p>"
      },
      {
        "id": "guide-install",
        "guideStepId": "install",
        "icon": "help_outline",
        "title": "Install a home-screen shortcut",
        "blurb": "",
        "contentHtml": "<p>Installation opens this app in its own window and adds an icon. It does not create an account or grant permissions. This action appears only when the device supports it.</p>"
      }
    ],
    "isSystem": true
  },
  {
    "_id": "template-guide-setup-hu-v1",
