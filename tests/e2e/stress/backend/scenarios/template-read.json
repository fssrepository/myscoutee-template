  "reuseContext": true,
  "users": 6,
  "rampUpMs": 0,
  "durationMs": 60000,
  "thinkTimeMs": 25,
  "thinkTimeJitterMs": 0,
  "thresholds": {
    "errorRate": 0,
    "p95Ms": 1000,
    "p99Ms": 2000
