    },
    {
      "name": "profile",
      "collectionCase": "profile/auth-me"
    },
    {
      "name": "personal chat",
      "collectionCase": "chat/seeded-conversation"
    },
    {
      "name": "showcase",
      "collectionCase": "showcase/cards"
    },
    {
      "name": "documents",
      "collectionCase": "content/documents"
    },
    {
      "name": "notifications",
      "collectionCase": "notifications/inbox"
    }
  ]
