{
  "openapi": "3.1.0",
  "info": {
    "title": "Account profile read state",
    "version": "1.0.0",
    "description": "Account-owned menu counters evaluated under the signed actor, and bounded invalidation of existing account read caches. Cache eviction grants no profile mutation authority. No automatic retries."
  },
  "paths": {
    "/_internal/v1/accounts/profile-read-state/counters": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-MyScoutee-Session-Mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-MyScoutee-Actor-Delegation",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CounterQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMenuCountersDto"
                }
              }
            }
          },
          "400": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
