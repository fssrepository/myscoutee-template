        "type": "http",
        "scheme": "bearer",
        "description": "Scoped chat-counters service capability."
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
