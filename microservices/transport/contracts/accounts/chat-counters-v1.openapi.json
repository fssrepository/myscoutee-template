{
  "openapi": "3.1.0",
  "info": {
    "title": "chat-counters",
    "version": "1.0.0",
    "description": "Chat-only counter commands retain native single-update versus unordered-bulk behavior. All changes are validated before any owner mutation. Only existing named chat context fields may be incremented. REAL/DEMO and job scope preserved. Deltas are not automatically retried; acknowledgment recovery is still milestone 16. Requests bounded to 2 MiB/4096 identifiers, responses to 16 MiB. Implementation and contracts are not yet tested."
  },
