  "openapi": "3.1.0",
  "info": {
    "title": "account-notifications",
    "version": "1.0.0",
    "description": "Notifications-only capability for existing account recipient/device/sender data and preference/unread/token-cleanup operations. Push tokens and email are service-private and never public gateway data. Native reread before push-token cleanup and bulk behavior retained. REAL/DEMO and job scope preserved. Counter deltas are not retried; notification/counter lost-reply coordination remains milestone 16. Requests bounded to 2 MiB/4096 identifiers, responses to 16 MiB. Implementation and contracts are not yet tested."
  },
