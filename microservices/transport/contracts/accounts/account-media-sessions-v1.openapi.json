{
  "openapi": "3.1.0",
  "info": {
    "title": "Account media sessions",
    "version": "1.0.0",
    "description": "Native account session hash check, current hash and replacement. Media service capability and explicit REAL/DEMO required. Current/replace additionally require signed, native-revalidated selected-profile authority bound to the exact request body/path/mode. No raw cookie or Firebase credential is serialized. Token rotation is single-attempt; the existing browser profile read can request a new cookie if an acknowledgment is lost. 16 KiB request/response limit. Integration and public ingress not yet verified."
  },
  "paths": {
    "/_internal/v1/accounts/media-sessions/accepts": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
