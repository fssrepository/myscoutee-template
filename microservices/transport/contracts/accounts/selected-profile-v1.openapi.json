{
  "openapi": "3.1.0",
  "info": {
    "title": "Selected authenticated profile",
    "version": "1.0.0",
    "description": "Identity-owned, bounded internal operation. Service authentication does not grant actor authority. Responses are not cached. The discovery operation uses the same operation-bound actor proof and native resolveCurrentUser. It verifies the returned account/profile/workspace against the delegated principal and exposes only DiscoveryProfileDto, including stored affinity. It also supplies CurrentProfile consumers; this extension is not yet tested."
  },
  "paths": {
    "/_internal/v1/accounts/selected-profile": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-MyScoutee-Session-Mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-MyScoutee-Actor-Delegation",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestedUserId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolved",
          "identity"
        ],
        "properties": {
          "resolved": {
            "const": true
          },
          "identity": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "userId",
              "accountUserId",
              "workspaceGroupId"
            ],
            "properties": {
              "userId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "accountUserId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "workspaceGroupId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
