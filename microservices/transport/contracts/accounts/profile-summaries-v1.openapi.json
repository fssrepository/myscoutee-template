{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee profile-summaries",
    "version": "1.0.0",
    "description": "Account-owned identity, lifecycle and display facts for chat, community, events and affinity. Existing directory queries, ordering, duplicates, workspace selection and saved-contact semantics are retained. No financial, device-token or integration configuration fields. Account owner and explicitly listed consumer domains only; mandatory REAL/DEMO context. Requests bounded to 4096 identifiers / 2 MiB; replies capped at 8 MiB without truncation. Count replies capped at 16 KiB. No retries."
  },
