{
  "schemaVersion": 1,
  "issue": "MSC-122",
  "projectName": "myscoutee-template-microservices",
  "version": "1.0.0",
  "sharedJavaIncludes": [
    "common/config/NotificationParameters.java"
  ],
  "sharedConfigurationImports": [],
  "services": {
    "identity": {
      "domains": [
        "accounts",
        "access",
        "administration",
        "platform",
        "integrations",
        "showcase"
      ],
      "libraries": [
        "firebase",
        "bouncycastle"
      ],
      "starters": [
        "web",
        "actuator",
        "security",
        "validation",
        "data-mongodb",
        "data-redis",
        "cache",
        "data-rest"
      ],
      "memoryMiB": 1024,
      "heapMiB": 512,
      "runtimeStage": "jre-runtime"
    },
    "communication": {
      "domains": [
        "chat",
        "notifications",
        "email",
        "localization"
      ],
      "libraries": [
        "firebase"
      ],
      "starters": [
        "web",
        "actuator",
        "security",
        "validation",
        "data-mongodb",
        "data-redis",
        "cache",
        "websocket"
      ],
      "memoryMiB": 768,
      "heapMiB": 384,
      "runtimeStage": "jre-runtime"
    },
    "media": {
      "domains": [
        "media"
      ],
      "libraries": [
        "s3",
        "s3.http"
      ],
      "starters": [
        "web",
        "actuator",
        "security",
        "validation",
        "data-mongodb",
        "cache"
      ],
      "memoryMiB": 768,
      "heapMiB": 384,
      "runtimeStage": "media-runtime"
    },
    "help": {
      "domains": [
        "help"
      ],
      "libraries": [
        "jsoup"
      ],
      "starters": [
        "web",
        "actuator",
        "security",
        "validation",
        "data-mongodb",
        "cache"
      ],
      "memoryMiB": 512,
      "heapMiB": 256,
      "runtimeStage": "jre-runtime"
    }
  },
  "repositoryFactoryBean": "org.springframework.data.mongodb.repository.support.MongoRepositoryFactoryBean"
}
