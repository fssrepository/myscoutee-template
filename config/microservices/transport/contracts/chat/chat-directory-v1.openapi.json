{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee internal chat directory reads",
    "version": "1.0.0",
    "description": "Canonical ChatDirectory read operations. Explicit DTOs expose only directory-view fields, never chat documents or messages. Authenticated service read with mandatory REAL/DEMO; no delegated user authority. HTTPS except explicit isolated lab opt-in."
  },
  "paths": {
    "/_internal/v1/chat/directory/entry": {
      "get": {
        "operationId": "getChatDirectoryEntry",
        "security": [
          {
            "chatDirectoryRead": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "name": "ownerId",
            "in": "query",
            "required": false,
            "description": "Omitted retains canonical null; an empty string stays distinct.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "chatId",
            "in": "query",
            "required": false,
            "description": "Omitted retains canonical null; an empty string stays distinct.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical directory read; maximum 2 MiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatDirectoryEntryDto"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_SESSION_MODE or INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: absent, duplicate or wrong read credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN: credential does not authorize another path or method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CHAT_DIRECTORY_UNAVAILABLE: owner failed; persistence details are not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND: the canonical directory has no group for this ID in the selected session mode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
