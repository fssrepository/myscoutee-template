              "type": [
                "string",
                "null"
              ]
            },
            "chatId": {
              "type": [
                "string",
                "null"
              ]
            },
            "ownerId": {
              "type": [
                "string",
                "null"
              ]
            },
            "ownerUserId": {
              "type": [
                "string",
                "null"
              ]
            },
            "channelType": {
              "type": [
                "string",
                "null"
              ]
            },
            "supportBaseGroupId": {
              "type": [
                "string",
                "null"
              ]
            },
            "memberIds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "supportCase": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
