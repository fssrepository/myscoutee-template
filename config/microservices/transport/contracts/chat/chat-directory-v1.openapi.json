  },
  "components": {
    "securitySchemes": {
      "chatDirectoryRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated internal group-media read credential of at least 256 random bits. Never distribute to browsers or put in URLs."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CHAT_DIRECTORY_UNAVAILABLE"
            ]
          }
        }
      },
      "ChatDirectoryEntryDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unread",
          "title",
          "chatId",
          "ownerId",
          "ownerUserId",
          "channelType",
          "supportBaseGroupId",
          "memberIds",
          "supportCase"
        ],
        "properties": {
          "unread": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "chatId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "channelType": {
            "type": [
              "string",
              "null"
            ]
          },
          "supportBaseGroupId": {
            "type": [
              "string",
              "null"
            ]
          },
          "memberIds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "supportCase": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "ChatDirectoryEntries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unread",
            "title",
            "chatId",
            "ownerId",
            "ownerUserId",
            "channelType",
            "supportBaseGroupId",
            "memberIds",
            "supportCase"
          ],
          "properties": {
