{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee role-attention-events",
    "version": "1.0.0",
    "description": "Typed calls to the existing RoleAttentionEvents owner. Native validation, queries, state transitions and scheduler behavior retained. REAL/DEMO and explicit job scope; no-store. 2 MiB request / 8 MiB response bounds; no automatic retries."
  },
  "paths": {
    "/_internal/v1/integrations/role-attention-events/enqueue": {
      "post": {
        "operationId": "role_attention_events_enqueue",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Canonical owner unavailable; operation outcome is not assumed successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Native owner rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated role-attention-events capability for notifications."
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Scope"
              },
              {
                "type": "null"
              }
            ]
          },
          "notification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RoleAttention"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "active"
        ]
      },
      "RoleAttention": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "entityType": {
            "type": [
              "string",
              "null"
            ]
          },
          "notificationType": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipientUserIds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "required": []
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "const": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "OWNER_REJECTED",
              "ROLE_ATTENTION_EVENTS_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
