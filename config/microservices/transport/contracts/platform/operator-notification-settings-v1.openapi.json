{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee operator-notification-settings",
    "version": "1.0.0",
    "description": "One owner snapshot of configured operator notification emails. Excludes bootstrap password hashes, Firebase paths, provider secrets and unrelated runtime configuration. Mandatory REAL/DEMO request context, dedicated server-only read capability, 16 KiB reply bound, no retries."
  },
  "paths": {
    "/_internal/v1/platform/operator-notification-recipients": {
      "get": {
        "operationId": "operatorNotificationRecipients",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated operator-notification-settings read credential; never expose to browsers."
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "users"
        ],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bootstrapEmail": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "OPERATOR_NOTIFICATION_SETTINGS_UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
