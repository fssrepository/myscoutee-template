  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Notifications-only push-delivery capability; no Firebase credentials or runtime SDK object is exported."
      }
    },
    "schemas": {
      "WebPush": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "body": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "badge": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "tag": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "timestampMillis": {
            "type": "integer"
          },
          "urgency": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "link": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          }
        },
        "required": [
          "timestampMillis"
        ]
      },
      "PushMessage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "topic": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "data": {
            "type": "object",
            "maxProperties": 128,
            "propertyNames": {
              "maxLength": 256
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "webPush": {
            "$ref": "#/components/schemas/WebPush"
          }
        },
        "required": [
          "data",
          "webPush"
        ]
      },
      "PushMulticast": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "data": {
            "type": "object",
            "maxProperties": 128,
            "propertyNames": {
              "maxLength": 256
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "webPush": {
            "$ref": "#/components/schemas/WebPush"
          }
        },
        "required": [
          "tokens",
          "data",
          "webPush"
        ]
      },
      "Single": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "$ref": "#/components/schemas/PushMessage"
          }
        },
        "required": [
          "message"
        ]
      },
      "Batch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/PushMessage"
            }
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        "required": [
          "messages",
          "tokens"
        ]
      },
      "Multicast": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "$ref": "#/components/schemas/PushMulticast"
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        },
        "required": [
          "message",
          "tokens"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "const": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "TokenResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "successful": {
            "type": "boolean"
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        },
        "required": [
          "successful"
        ]
      },
      "BatchResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "successCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "failureCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 500
          },
          "responses": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/TokenResult"
            }
          }
        },
        "required": [
          "successCount",
          "failureCount",
          "responses"
        ]
      }
    }
  }
}
