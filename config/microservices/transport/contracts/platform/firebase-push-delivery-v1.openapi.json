{
  "openapi": "3.1.0",
  "info": {
    "title": "Firebase push delivery",
    "version": "1.0.0",
    "description": "Existing notification worker prepares token/topic/data and WebPush presentation; platform owns SDK construction and the existing activated Firebase runtime. Single, direct-batch and multicast sends retain token ordering, counts and per-token error codes. 8 MiB/500 messages request bound, 512 KiB response, 30-second request window. REAL/DEMO preserved; canonical runtime rejects live Firebase sends in DEMO. No transport retry; the existing notification outbox owns retry policy. Unknown provider acknowledgment remains a workflow concern, not exactly-once delivery."
  },
  "paths": {
    "/_internal/v1/platform/firebase-push/single": {
      "post": {
        "operationId": "firebasePushSingle",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Single"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider failed, unavailable, or send outcome unknown; transport never retries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/_internal/v1/platform/firebase-push/batch": {
      "post": {
        "operationId": "firebasePushBatch",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
