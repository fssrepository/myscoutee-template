{
  "openapi": "3.1.0",
  "info": {
    "title": "MyScoutee deployment-branding",
    "version": "1.0.0",
    "description": "Only the existing resolved public branding DTO; native owner fallback rules remain unchanged. Uses service-scoped capability authentication, preserves REAL/DEMO context, prohibits automatic retries and returns Cache-Control: no-store."
  },
  "paths": {
    "/_internal/v1/platform/branding": {
      "get": {
        "operationId": "deployment_branding",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Owner unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated service capability for this contract; never expose to browsers."
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resolved": {
            "const": true
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "productName": {
                "type": "string"
              },
              "logoUrl": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              }
            },
            "required": [
              "productName",
              "logoUrl",
              "revision"
            ]
          }
        },
        "required": [
          "resolved",
          "value"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_SESSION_MODE",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "QUERY_TOO_LARGE",
              "INVALID_CONTENT_TYPE",
              "OWNER_REJECTED",
              "BRANDING_UNAVAILABLE"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
