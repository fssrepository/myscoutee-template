{
  "openapi": "3.1.0",
  "info": {
    "title": "Media cleanup",
    "version": "1.0.0",
    "description": "Owner-side existing MinIO deletion for domain purge stages. Accounts, assets, chat, content and events only. Strict failure propagates to the existing durable job; best-effort API retains its canonical exception handling. 16 KiB request and response bounds; no automatic retry."
  },
  "paths": {
    "/_internal/v1/media/media-cleanup/delete": {
      "post": {
        "operationId": "deletePublicObjectOrThrow",
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "name": "X-MyScoutee-Session-Mode",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical owner result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or session mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong service capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds byte limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Native purge failed or outcome unknown; existing durable account job retains retry ownership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer",
        "description": "Domain purge-worker capability for media cleanup only."
      }
    },
    "schemas": {
      "Scope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "groupId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "active"
        ]
      },
      "UserCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          }
        },
        "required": [
          "scope"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "completed"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}
