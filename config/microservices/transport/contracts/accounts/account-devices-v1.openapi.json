{
  "openapi": "3.1.0",
  "info": {
    "title": "Account device commands",
    "version": "1.0.0",
    "description": "Chat-only service capability plus body/path/mode-bound actor delegation. The account owner reloads the selected profile and requires exact identity before invoking its existing device register/remove logic. 32 KiB requests, 16 KiB acknowledgments. No token in responses or logs. Single attempt; failed/unknown replies are never retried automatically. This adapter does not claim exactly-once registration or change native timestamp/concurrency behavior."
  },
  "paths": {
    "/_internal/v1/accounts/devices/register": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-MyScoutee-Session-Mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-MyScoutee-Actor-Delegation",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "registerDevice"
      }
    },
    "/_internal/v1/accounts/devices/remove": {
      "post": {
        "security": [
          {
            "serviceCapability": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-MyScoutee-Session-Mode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "REAL",
                "DEMO"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-MyScoutee-Actor-Delegation",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Remove"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Rejected or unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "removeDevice"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceCapability": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Register": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "deviceId",
          "firebaseToken",
          "platform",
          "enabled"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "deviceId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "firebaseToken": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "Remove": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "deviceId",
          "firebaseToken"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "deviceId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "firebaseToken": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "completed"
        ],
        "properties": {
          "completed": {
            "const": true
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
