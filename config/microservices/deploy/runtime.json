{
  "schemaVersion": 1,
  "rolloutTimeoutSeconds": 600,
  "mongoCpuLimit": 3,
  "mongoReplicaSet": true,
  "namespace": "myscoutee-template",
  "frontendReplicas": 1,
  "frontendNodePort": 30080,
  "localPort": 18080,
  "volumeImages": {
    "mongo-seed": "myscoutee-template-service-mongo-seed:1.5.0"
  },
  "dependencies": {
    "frontend": "myscoutee-template-service-frontend:1.5.0",
    "mongodb": "mongo:8.0.4",
    "redis": "redis:8.6.1-alpine",
    "minio": "myscoutee-template-service-minio:1.5.0",
    "stun": "myscoutee-template-service-stun:1.5.0",
    "mcp": "myscoutee-template-service-mcp:1.5.0",
    "release-simulator": "myscoutee-template-service-release-simulator:1.5.0"
  },
  "stunNodePort": 30478,
  "metricsNodePort": 30081,
  "lab": {
    "displayName": "MyScoutee Template",
    "stateDirectory": "myscoutee-template/microservices",
    "vmName": "myscoutee-template",
    "bridge": "virbr-msctpl",
    "networkCidr": "192.168.174.0/24",
    "memoryMiB": 6144,
    "macAddress": "52:54:00:12:20:01",
    "monitoringProject": "myscoutee-template-observability",
    "grafanaPort": 13000,
    "prometheusPort": 19090,
    "grafanaPassword": "template-local-only"
  },
  "images": {
    "prefix": "myscoutee-template-service-",
    "buildTag": "1.5.0",
    "immutableVersion": "1.5.0",
    "frontendBase": "myscoutee-template-frontend-runtime-base:1.5.0",
    "nginxBase": "ghcr.io/fssrepository/myscoutee-nginx:1.5.0@sha256:9ab49ea949afaee5164e828b699c102dca38a2766d7573c4f342984e8da74774",
    "supportSources": {
      "mcp": "config/mcp",
      "stun": "../myscoutee-microservices/deploy/stun"
    }
  },
  "databases": {
    "real": "template_real",
    "demo": "template_demo",
    "bootstrap": "template_bootstrap",
    "replicaSet": "template"
  },
  "environment": {
    "SPRING_PROFILES_ACTIVE": "prod",
    "MONGODB_HOST": "mongodb",
    "MONGODB_PORT": "27017",
    "SPRING_DATA_REDIS_HOST": "redis",
    "FIREBASE_ENABLED": "false",
    "MEDIA_ENABLED": "true",
    "MEDIA_OBJECT_STORE_ENDPOINT": "http://minio:9000",
    "MEDIA_OBJECT_STORE_REGION": "eu-central-1",
    "MEDIA_BUCKET": "myscoutee-media",
    "MEDIA_OBJECT_STORE_PATH_STYLE": "true",
    "EMAIL_ENABLED": "false",
    "CHAT_CALL_STUN_URLS": "stun:@VM_IP@:@STUN_NODE_PORT@",
    "CHAT_CALL_STUN_HEALTH_HOST": "stun",
    "CONFIG_MCP_DEMO_ENABLED": "true",
    "WEBSOCKET_ALLOWED_ORIGIN_PATTERNS": "@PUBLIC_BASE_URL@,@LOOPBACK_BASE_URL@",
    "MYSCOUTEE_VERSION": "1.5.0"
  },
  "publicRoutes": [
    {
      "pattern": "~^/api/(?:help|privacy|terms|explanation)(?:/|$)",
      "service": "help"
    },
    {
      "pattern": "~^/api/public/email/unsubscribe(?:/|$)",
      "service": "communication"
    },
    {
      "pattern": "~^/api/(?:activities/chats|notifications|i18n|operator/email-configuration)(?:/|$)",
      "service": "communication"
    },
    {
      "pattern": "~^/api/media(?:/|$)",
      "service": "media"
    },
    {
      "pattern": "~^/api/(?:admin|admin-client/v1|auth|deployment/configuration|integrations|mcp/oauth|navigator/contacts|operator|showcase)(?:/|$)",
      "service": "identity"
    }
  ],
  "configurationKeyPath": "/etc/myscoutee-template/configuration/deployment-master-key"
}
