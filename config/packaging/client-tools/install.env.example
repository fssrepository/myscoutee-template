# Copy this file to install.env and restrict it before adding credentials:
#   cp install.env.example install.env
#   chmod 0600 install.env

REMOTE_HOST=
REMOTE_USER=
REMOTE_PORT=22

# Prefer a dedicated SSH key. Password authentication remains supported without
# placing the password in process arguments or the environment.
REMOTE_KEY_FILE=
REMOTE_PASSWORD=

# Defaults to REMOTE_PASSWORD when empty. Prefer a narrowly scoped sudo policy
# or passwordless sudo for the deployment account where operationally suitable.
REMOTE_SUDO_PASSWORD=

# Empty uses /tmp/<packageName>.deb from the trusted release-project.json.
REMOTE_DEB_PATH=
REMOTE_HOST_KEY_CHECKING=accept-new
REMOTE_CONNECT_TIMEOUT_SECONDS=20
REMOTE_SSH_OPTIONS=

RUN_APT_UPDATE=false
START_SERVICE=true
STOP_ON_FAILURE=true
QUALIFY_TIMEOUT_SECONDS=300
ALLOW_DOWNGRADE=false

# GitHub Release verification. Pin the full SPKI fingerprint through an
# independent channel; a key downloaded beside the artifacts is not by itself
# a trust anchor.
RELEASE_MANIFEST_PATH=
RELEASE_PUBLIC_KEY_PATH=
RELEASE_PUBLIC_KEY_FINGERPRINT=

# Development-only escape hatch for a package built directly from this
# checkout. Keep false for every downloaded or published artifact.
ALLOW_UNSIGNED_LOCAL_PACKAGE=false

# Optional URL printed after host qualification. Run verify-deployment
# separately from the client so it remains a real external transport check.
VERIFY_DEPLOYMENT_URL=

# Comma-separated local[:remote] loopback mappings. A bare port is same-port.
# For a one-shot non-privileged tunnel without editing this file:
#   LOCAL_FORWARD_PORTS_OVERRIDE=18080:80,18443:443 ./forward-localhost.sh
LOCAL_FORWARD_HOST=127.0.0.1
LOCAL_FORWARD_REMOTE_HOST=127.0.0.1
LOCAL_FORWARD_PORTS=80,443
