{
  "schemaVersion": 1,
  "packageName": "myscoutee-template",
  "composeServices": [
    "stun",
    "mcp",
    "nginx",
    "mongodb",
    "redis",
    "minio",
    "profilemanagement"
  ],
  "backupComponents": [
    "mongodb",
    "configuration",
    "operatorConfigurationKey",
    "minio"
  ],
  "restartInfrastructureCommand": "compose up -d --no-deps --wait --wait-timeout 300 mcp minio mongodb redis stun"
}
